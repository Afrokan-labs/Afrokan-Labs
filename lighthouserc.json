{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "numberOfRuns": 3,
      "autodiscoverUrlBlocklist": [
        "/_primitives.html",
        "/_fixtures/none.html",
        "/_fixtures/anonymised.html",
        "/_fixtures/named.html",
        "/_fixtures/case-study/anonymised.html",
        "/_fixtures/case-study/named.html"
      ],
      "maxAutodiscoverUrls": 0
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median-run"
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 1000000
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 120000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
