# Cloudflare Pages response headers (architecture §13, CLAUDE.md override #1).
#
# CSP: Next's static export emits inline scripts (the RSC payload) and there is
# no server to issue nonces, so script-src needs 'unsafe-inline'. Everything
# else stays strict. Analytics: Cloudflare Web Analytics injects its beacon at
# the edge; it loads from static.cloudflareinsights.com and reports to
# cloudflareinsights.com (src/lib/analytics.ts; keep them in step).
#
# Cloudflare joins repeated headers with a comma, so a later rule that
# replaces Cache-Control first removes it with "! Cache-Control".

# Every response. Cache-Control here is for HTML and RSC payloads: always
# revalidate, so a deploy shows at once.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed JS, CSS and fonts: the file name changes when the file does.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The contact form: the only page that loads Turnstile (architecture §13). Its
# CSP replaces the site-wide one, adding challenges.cloudflare.com to
# script-src and frame-src (TURNSTILE_ORIGIN in src/lib/contact-fields.ts).
# Cloudflare would comma-join two CSPs, and browsers enforce both.
/contact
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Optimised images keep their names across rebuilds, so cache them for a day.
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Plain-text files for machines: security.txt (RFC 9116 asks for UTF-8 plain
# text, served from public/ as-is) and llms.txt (written at build time by
# src/app/llms.txt/route.ts).
/.well-known/security.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8

/llms.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
