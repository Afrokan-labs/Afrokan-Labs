# Cloudflare Pages response headers (architecture §13, CLAUDE.md override #1).
#
# CSP: Next's static export emits inline scripts (the RSC payload) and there is
# no server to issue nonces, so script-src needs 'unsafe-inline'. Everything
# else stays strict. Analytics: Umami loads from cloud.umami.is and sends to
# gateway.umami.is (ANALYTICS_SCRIPT / ANALYTICS_ENDPOINT_ORIGIN in
# src/lib/analytics.ts; keep them in step).
#
# Cloudflare joins repeated headers with a comma, so a later rule that
# replaces Cache-Control first removes it with "! Cache-Control".

# Every response. Cache-Control here is for HTML and RSC payloads: always
# revalidate, so a deploy shows at once.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://gateway.umami.is; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed JS, CSS and fonts: the file name changes when the file does.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The contact form: the only page that loads Turnstile (architecture §13). Its
# CSP replaces the site-wide one, adding challenges.cloudflare.com to
# script-src and frame-src (TURNSTILE_ORIGIN in src/lib/contact-fields.ts).
# Cloudflare would comma-join two CSPs, and browsers enforce both.
/contact
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://gateway.umami.is; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Optimised images keep their names across rebuilds, so cache them for a day.
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
