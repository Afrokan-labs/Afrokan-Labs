# Copy to .env.local for local development. Never commit any other .env file.
# Only NEXT_PUBLIC_* variables are read by the Next build (validated in BUILD_PLAN 1.5).
# Business details (WhatsApp number, email) are content, not config: src/content/site.ts.

# Canonical URL, sitemap and OG URLs. Differs for preview deployments.
NEXT_PUBLIC_SITE_URL=https://afrokanlabs.com
# Umami website ID. Leave unset in previews and locally; track() then does nothing.
NEXT_PUBLIC_ANALYTICS_ID=
# Cloudflare Turnstile site key for /contact. Locally and in previews use the
# published test key below (always passes); production uses the real key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The contact form's Pages Function reads its secrets at runtime, never at
# build time. For `wrangler pages dev`, put them in .dev.vars (git-ignored):
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   (test secret, always passes)
#   RESEND_API_KEY=...
#   CONTACT_TO_EMAIL=hello@afrokanlabs.com
