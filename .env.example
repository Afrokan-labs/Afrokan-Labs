# Copy to .env.local for local development. Used only by app/api/contact/route.ts.
# Site details (email, WhatsApp, booking link) are not env vars; they live in content/site.ts.

# Contact form delivery (https://resend.com — free tier is enough)
RESEND_API_KEY=
# Where contact form messages should land
CONTACT_TO_EMAIL=hello@afrokanlabs.com
# Sender address; must be on a domain verified in Resend
CONTACT_FROM_EMAIL=Afrokan Labs website <website@afrokanlabs.com>
