{
  "name": "afrokan-labs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "tsx scripts/optimize-images.ts && next dev",
    "build": "tsx scripts/unshallow.ts && tsx scripts/optimize-images.ts && tsx scripts/validate-content.ts && next build && tsx scripts/preload-fonts.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:validate": "tsx scripts/validate-content.ts",
    "images": "tsx scripts/optimize-images.ts",
    "icons": "tsx scripts/icons.ts",
    "og": "tsx scripts/og-images.ts",
    "lhci": "lhci collect && lhci upload && tsx scripts/lhci-summary.ts && lhci assert",
    "a11y": "tsx scripts/a11y.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "content:audit": "tsx scripts/content-audit.ts",
    "test:contact": "tsx scripts/test-contact.ts",
    "test:contact-form": "tsx scripts/test-contact-form.ts",
    "email:test": "tsx scripts/email-test.ts",
    "email:assets": "tsx scripts/email-assets.ts",
    "email:signatures": "tsx scripts/email-signatures.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.9.9",
    "sharp": "^0.34.5",
    "simple-git-hooks": "2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm format:check && pnpm lint && pnpm typecheck"
  }
}
