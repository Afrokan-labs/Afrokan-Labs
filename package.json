{
  "name": "afrokan-labs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:validate": "node -e \"console.log('content:validate: stub until BUILD_PLAN 1.4')\"",
    "images": "node -e \"console.log('images: stub until BUILD_PLAN 2.6')\"",
    "lhci": "node -e \"console.log('lhci: stub until BUILD_PLAN 1.6')\"",
    "launch:check": "node -e \"console.error('launch:check: stub until BUILD_PLAN 1.5; failing until it can scan for TODO_'); process.exit(1)\""
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.1.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^5"
  }
}
